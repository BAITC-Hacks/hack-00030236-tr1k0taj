POSTGRES_USER=voice_router
POSTGRES_PASSWORD=voice_router
POSTGRES_DB=voice_router
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Agent kernel: keys stay on the backend. MOCK_MODE=true is explicitly a simulation.
OPENAI_API_KEY=
MOCK_MODE=true
LLM_MODEL=gpt-4.1-mini
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Провайдеры этапов (ADR 0008). mock — запуск без ключей: сценарий не выбирается,
# API отвечает понятной ошибкой llm_unavailable / stt_unavailable вместо 401.
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
