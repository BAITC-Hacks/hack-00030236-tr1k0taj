POSTGRES_USER=voice_router
POSTGRES_PASSWORD=voice_router
POSTGRES_DB=voice_router
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Agent kernel: keys stay on the backend. MOCK_MODE=true is explicitly a simulation.
OPENAI_API_KEY=
MOCK_MODE=true
LLM_MODEL=gpt-4.1-mini
# ROUTER_MODEL=gpt-4.1-nano — perf/latency: в быстром ручном тесте (3 реплики ru/kk/mixed)
# nano выбрал те же сценарии, что и mini, но latency не была стабильно ниже (шум сети/кэша).
# just eval не гонялся — прежде чем включать по умолчанию, нужен прогон на dev-наборе.
#ROUTER_MODEL=gpt-4.1-nano
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Провайдеры этапов (ADR 0008). mock — запуск без ключей: сценарий не выбирается,
# API отвечает понятной ошибкой llm_unavailable / stt_unavailable вместо 401.
STT_PROVIDER=mock
# LLM_PROVIDER=openai — боевой роутер (Responses API, модель LLM_MODEL); без OPENAI_API_KEY отдаёт llm_unavailable.
LLM_PROVIDER=mock
TTS_PROVIDER=mock
# STT/TTS на OpenAI: STT_PROVIDER=openai, TTS_PROVIDER=openai + OPENAI_API_KEY.
# Внимание: голос клиента тогда уходит во внешний API OpenAI (opt-in).
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# короткая фраза-заглушка ("Секунду, проверяю.") сразу после route-решения, до готовности ответа
TTS_FILLER=true

# Трассировка OpenTelemetry (ADR 0013). Трассы звонков пишутся в Postgres (trace_spans, GET /traces/*);
# OTLP — дополнительно, если задан endpoint.
# Пример для локального Jaeger: OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=voice-router-backend
# Отправлять ли в OTLP промпты/транскрипты (атрибуты local.*); по умолчанию нет.
# TRACE_EXPORT_CONTENT=false
