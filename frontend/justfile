# Frontend-only development; the full project still starts with root `just up`.
set windows-shell := ["cmd.exe", "/c"]

dev port="3000":
    npm run dev -- --hostname 0.0.0.0 --port {{port}}

check:
    npx tsc --noEmit

lint:
    npm run lint

build:
    npm run build

test:
    node --experimental-strip-types --test tests/stream.test.mjs tests/catalog.test.mjs tests/trace.test.mjs
